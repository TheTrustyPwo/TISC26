---
import entries from '../data/generated.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentSlug?: string;
}

const { title, description, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
const route = (slug: string) => `${base}challenges/${slug}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const current = entries.find((entry) => entry.slug === currentSlug);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#18303A" />
    <meta name="description" content={description} />
    <meta property="og:type" content={currentSlug ? 'article' : 'website'} />
    <meta property="og:site_name" content="TISC 2026 writeups" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title} | TISC 2026 writeups</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="site-shell">
      <aside class="route-rail" aria-label="Site navigation">
        <div class="rail-inner">
          <a class="brand" href={base} aria-label="TISC 2026 writeups overview">
            <span class="brand-type" translate="no">TISC <span>26</span><small>Writeups</small></span>
          </a>
          <nav class="desktop-nav" aria-label="Challenges">
            <p class="nav-label">Challenge route</p>
            <ol class="route-list">
              {entries.map((entry) => <li>
                <a href={route(entry.slug)} aria-current={entry.slug === currentSlug ? 'page' : undefined}>
                  <span class="route-number">{entry.marker}</span>
                  <span class="route-name">{entry.title}</span>
                </a>
              </li>)}
            </ol>
          </nav>
          <div class="rail-foot"><a href={currentSlug ? base : '#reports-heading'}>{currentSlug ? 'About & contacts' : 'Jump to challenge index'} <span aria-hidden="true">↗</span></a></div>
        </div>
      </aside>
      <div class="mobile-chrome">
        <a class="mobile-brand" href={base}>TISC <span>26</span> <small>Writeups</small></a>
        <details class="mobile-nav">
          <summary><span>{current ? `${current.label}: ${current.title}` : 'Browse challenges'}</span><span aria-hidden="true" class="chevron">⌄</span></summary>
          <nav aria-label="Challenges"><ol>
            {entries.map((entry) => <li><a href={route(entry.slug)} aria-current={entry.slug === currentSlug ? 'page' : undefined}><span>{entry.marker}</span>{entry.title}</a></li>)}
          </ol></nav>
        </details>
      </div>
      <div class="content-shell">
        <slot />
        <footer class="site-footer"><span>TISC 2026 writeups</span><a href={base}>All challenges</a></footer>
      </div>
    </div>
  </body>
</html>
