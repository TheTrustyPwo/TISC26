---
import BaseLayout from '../layouts/BaseLayout.astro';
import entries from '../data/generated.json';
import { cover } from '../data/cover.mjs';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Challenge archive" description="Eleven TISC 2026 challenge writeups with evidence and selected solve artifacts.">
  <main id="main" class="overview">
    <header class="page-head overview-head">
      <p class="kicker cover-rankings">{cover.ranking}</p>
      <h1>TISC <span>2026</span><br />{' '}Writeups<span class="cover-period">.</span></h1>
      <div class="cover-bottom">
        <blockquote class="cover-note">
          <p class="cover-quote">“{cover.intro[0]}”</p>
          <p class="cover-aside">{cover.intro[1]}</p>
        </blockquote>
        <div class="cover-byline">
          <p>Written by <strong>{cover.author}</strong></p>
          <address class="cover-contact">
            <a href={cover.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
            <a href={cover.github}>GitHub <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${cover.email}`}>{cover.email}</a>
          </address>
        </div>
      </div>
    </header>
    <section class="overview-list" aria-labelledby="reports-heading">
      <div class="section-heading"><h2 id="reports-heading">Challenge index</h2><span>Specials → 9 to 1</span></div>
      <ol class="case-list">
        {entries.map((entry) => <li>
          <a href={`${base}challenges/${entry.slug}/`}>
            <span class="case-index">{entry.marker}<small>{entry.level === null ? 'Special' : 'Level'}</small></span>
            <span class="case-name">{entry.title}{entry.placement && <small class={`case-placement${entry.placement === '1st place' ? ' case-placement--first' : entry.placement === '3rd place' ? ' case-placement--third' : ''}`}>{entry.placement}</small>}</span>
            <span class="case-detail">Read writeup <span aria-hidden="true">↗</span></span>
          </a>
        </li>)}
      </ol>
    </section>
  </main>
</BaseLayout>
