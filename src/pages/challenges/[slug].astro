---
import BaseLayout from '../../layouts/BaseLayout.astro';
import entries from '../../data/generated.json';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const previous = entries[entry.order - 2];
const next = entries[entry.order];
const route = (slug: string) => `${base}challenges/${slug}/`;
const counterConfigured = Boolean(import.meta.env.PUBLIC_COUNTER_API_URL);
---
<BaseLayout title={entry.title} description={`Technical writeup and selected artifacts for ${entry.title}, a TISC 2026 challenge.`} currentSlug={entry.slug}>
  <main id="main" class:list={['report-page', { 'is-special': entry.level === null }]}>
    <header class="page-head report-head">
      <p class="kicker">{entry.label}</p>
      <h1>{entry.title}</h1>
      {counterConfigured && <div class="report-counts" data-counter data-slug={entry.slug}>
        <p class="view-count"><span data-views>—</span> <span data-view-label>views</span></p>
        <button class="like-button" type="button" aria-pressed="false" disabled>
          <span class="like-symbol" aria-hidden="true">♡</span>
          <span data-like-label>Like</span>
          <span class="like-total" data-likes>—</span>
        </button>
        <span class="counter-status" role="status" data-counter-status></span>
      </div>}
    </header>
    <div class="report-layout">
      {entry.headings.length > 2 && <nav class="toc" aria-label="On this page">
        <h2>On this page</h2>
        <ol>{entry.headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol>
      </nav>}
      {entry.headings.length > 2 && <details class="toc-mobile">
        <summary>On this page <span aria-hidden="true">⌄</span></summary>
        <nav aria-label="On this page"><ol>{entry.headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol></nav>
      </details>}
      <article class="writeup" aria-label={`${entry.title} writeup`}>
        <div class="markdown" set:html={entry.html} />
        {entry.resources.length > 0 && <section class="resources" aria-labelledby="resources-heading">
          <h2 id="resources-heading">Resources &amp; downloads</h2>
          <p>Selected files referenced by or useful for reproducing this solve.</p>
          <ul>{entry.resources.map((resource) => <li><a href={resource.href} download><span>{resource.label}</span><small>{resource.filename}</small></a></li>)}</ul>
        </section>}
        <nav class="report-pagination" aria-label="Other challenges">
          {previous ? <a href={route(previous.slug)}><small>Previous challenge</small><span>{previous.title}</span></a> : <a href={base}><small>Overview</small><span>All challenges</span></a>}
          {next && <a href={route(next.slug)}><small>Next challenge</small><span>{next.title}</span></a>}
        </nav>
      </article>
    </div>
  </main>
</BaseLayout>
<script>
  const counter = document.querySelector<HTMLElement>('[data-counter]');
  const api = import.meta.env.PUBLIC_COUNTER_API_URL;
  if (counter && api) {
    const slug = counter.dataset.slug;
    const views = counter.querySelector<HTMLElement>('[data-views]')!;
    const viewLabel = counter.querySelector<HTMLElement>('[data-view-label]')!;
    const likes = counter.querySelector<HTMLElement>('[data-likes]')!;
    const label = counter.querySelector<HTMLElement>('[data-like-label]')!;
    const symbol = counter.querySelector<HTMLElement>('.like-symbol')!;
    const button = counter.querySelector<HTMLButtonElement>('.like-button')!;
    const status = counter.querySelector<HTMLElement>('[data-counter-status]')!;
    let saving = false;
    const storageKey = `tisc26-like-id:${slug}`;
    const sessionKey = 'tisc26-view-session';
    let voterId: string;
    let sessionId: string;
    try {
      voterId = localStorage.getItem(storageKey) || crypto.randomUUID();
      localStorage.setItem(storageKey, voterId);
    } catch {
      voterId = crypto.randomUUID();
    }
    try {
      sessionId = sessionStorage.getItem(sessionKey) || crypto.randomUUID();
      sessionStorage.setItem(sessionKey, sessionId);
    } catch {
      sessionId = crypto.randomUUID();
    }

    type Counts = { views: number; likes: number; liked: boolean };
    async function send(action: string): Promise<Counts> {
      const response = await fetch(`${api}/${action}`, {
        method: 'POST',
        mode: 'cors',
        credentials: 'omit',
        cache: 'no-store',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug, voterId, sessionId }),
      });
      if (!response.ok) throw new Error(`Counter request failed: ${response.status}`);
      const data: Counts = await response.json();
      if (!Number.isSafeInteger(data.views) || !Number.isSafeInteger(data.likes) || typeof data.liked !== 'boolean') {
        throw new Error('Invalid counter response');
      }
      return data;
    }

    function render(data: Counts) {
      views.textContent = data.views.toLocaleString();
      viewLabel.textContent = data.views === 1 ? 'view' : 'views';
      likes.textContent = data.likes.toLocaleString();
      label.textContent = data.liked ? 'Liked' : 'Like';
      symbol.textContent = data.liked ? '♥' : '♡';
      button.setAttribute('aria-pressed', String(data.liked));
      button.disabled = false;
    }

    void (async () => {
      try {
        render(await send('view'));
      } catch {
        try {
          render(await send('state'));
        } catch {
          status.textContent = 'Counts are unavailable. Reload to try again.';
        }
      }
    })();

    button.addEventListener('click', async () => {
      if (saving) return;
      saving = true;
      button.setAttribute('aria-busy', 'true');
      status.textContent = '';
      try {
        render(await send(button.getAttribute('aria-pressed') === 'true' ? 'unlike' : 'like'));
      } catch {
        status.textContent = 'Could not save your like. Try again.';
      } finally {
        saving = false;
        button.removeAttribute('aria-busy');
      }
    });
  }

  window.addEventListener('message', (event) => {
    if (event.data?.type !== 'tisc-explainer-height') return;
    const frame = [...document.querySelectorAll<HTMLIFrameElement>('.explainer iframe')]
      .find((item) => item.contentWindow === event.source);
    const height = Number(event.data.height);
    if (frame && Number.isFinite(height) && height >= 300 && height <= 10000) {
      frame.style.height = `${height}px`;
    }
  });
</script>
